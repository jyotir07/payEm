# Formatting rules for payments-platform monorepo.
# Ensures consistent indentation, line endings, and charset across editors.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,mod}]
indent_style = tab
indent_size = 4

[*.{java,gradle,kt}]
indent_style = space
indent_size = 4

[*.{scala,sbt}]
indent_style = space
indent_size = 2

[*.rb]
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,json,css,scss,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
